{
  "name": "byte-desk",
  "productName": "Byte Desk",
  "version": "0.1.0",
  "description": "Byte en tu escritorio: chat en vivo con la central de Byte, siempre en la barra (Windows y Mac).",
  "main": "src/main.js",
  "author": "Alejandro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "central-falsa": "node test/central-falsa.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never",
    "acceso-directo-mac": "bash mac/crear-acceso-directo.sh"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "co.byte.desk",
    "productName": "Byte Desk",
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icono.png",
      "extendInfo": {
        "LSUIElement": false
      },
      "identity": "-"
    },
    "win": {
      "icon": "assets/icono.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Byte Desk",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "artifactName": "Byte-Desk-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "../pc/byte_pantalla.html",
        "to": "cara/byte_pantalla.html"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alekore-lopez/byte-firmware.git"
  }
}
